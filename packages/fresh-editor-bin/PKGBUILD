pkgname=fresh-editor-bin
pkgver="0.5.2"
pkgrel="1"
pkgdesc="Fast terminal text editor with LSP support and TypeScript plugins"
arch=('x86_64')
url="https://sinelaw.github.io/fresh/"
license=('GPL-2.0-only')
depends=('gcc-libs' 'glibc' 'xz')
provides=('fresh-editor')
conflicts=('fresh-editor')
options=('!debug')

source=(
  "fresh-editor-${pkgver}-x86_64.tar.xz::https://github.com/sinelaw/fresh/releases/download/v${pkgver}/fresh-editor-x86_64-unknown-linux-gnu.tar.xz"
)
sha256sums=('d7c6600cdd5c813bcd118d84fbcc0559fe9396756a46fd0b7b0c1bf6c5cf8fd6')

package() {
  local release_dir="${srcdir}/fresh-editor-x86_64-unknown-linux-gnu"

  install -Dm755 "${release_dir}/fresh" \
    "${pkgdir}/usr/share/fresh-editor/fresh"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /usr/share/fresh-editor/fresh "${pkgdir}/usr/bin/fresh"

  install -Dm644 /dev/stdin \
    "${pkgdir}/usr/share/fresh-editor/install-receipt.toml" <<EOF
schema = 1
channel = "local-package"
version = "${pkgver}"
package_name = "${pkgname}"
managed = true
self_update = false
EOF

  install -Dm644 "${release_dir}/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${release_dir}/CHANGELOG.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
  install -Dm644 "${release_dir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${release_dir}/fresh.desktop" \
    "${pkgdir}/usr/share/applications/fresh.desktop"

  local icon size
  for icon in "${release_dir}"/icons/*/apps/fresh.png; do
    size="$(basename "$(dirname "$(dirname "${icon}")")")"
    install -Dm644 "${icon}" \
      "${pkgdir}/usr/share/icons/hicolor/${size}/apps/fresh.png"
  done
}
