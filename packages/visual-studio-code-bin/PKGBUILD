pkgname=visual-studio-code-bin
pkgver="1.129.1"
pkgrel="1"
pkgdesc="Visual Studio Code official binary build"
arch=('x86_64')
url="https://code.visualstudio.com"
license=('custom: commercial')
depends=(
  'alsa-lib'
  'gcc-libs'
  'glibc'
  'gnupg'
  'gtk3'
  'libnotify'
  'libsecret'
  'libxkbfile'
  'libxss'
  'lsof'
  'nss'
  'shared-mime-info'
  'xdg-utils'
)
provides=('code' 'vscode')
conflicts=('code')
options=('!strip')

source=(
  "code_${pkgver}_amd64.deb::https://update.code.visualstudio.com/${pkgver}/linux-deb-x64/stable"
)
sha256sums=('0cf912efe73db485839bda45cdcfe2ba35af3ad5876cc9786d9b04da2eb9ea51')

package() {
  bsdtar -xf data.tar.xz -C "${pkgdir}"

  install -dm755 "${pkgdir}/usr/bin"
  ln -sf /usr/share/code/bin/code "${pkgdir}/usr/bin/code"

  sed -i -e 's/^\(Exec=\)[^ ]*/\1code/g' \
    "${pkgdir}"/usr/share/applications/*.desktop

  chmod u-s "${pkgdir}/usr/share/code/chrome-sandbox"
}
