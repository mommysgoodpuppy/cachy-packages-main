pkgname=gale-bin
pkgver="1.20.0"
pkgrel="1"
pkgdesc="Modern mod manager for Thunderstore"
arch=('x86_64')
url="https://github.com/Kesomannen/gale"
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'webkit2gtk-4.1' 'xdg-utils' 'xz')
provides=('gale')
conflicts=('gale')
options=('!strip')

source=(
  "Gale_${pkgver}_amd64.deb::${url}/releases/download/${pkgver}/Gale_${pkgver}_amd64.deb"
)
sha256sums=('576532440bb44a2217b2f4e1ad48a5247f31f04d18c31f96027305b09db8827a')

package() {
  bsdtar -xf "${srcdir}/Gale_${pkgver}_amd64.deb" -C "${srcdir}"
  bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}"
}
