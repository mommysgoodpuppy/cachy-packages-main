# Maintainer: Ellie <ellie@local>

pkgname=gpuvis
pkgver=0.2
pkgrel=1
pkgdesc="GPU trace visualizer"
arch=('x86_64')
url="https://github.com/mikesart/gpuvis"
license=('MIT')
depends=('freetype2' 'gtk3' 'rapidjson' 'sdl2')
makedepends=('meson' 'ninja')
_commit=fe3d30268eedee65fdbfc06275d0762fd743c469
source=("${pkgname}-${pkgver}::git+${url}#commit=${_commit}")
sha256sums=('075f5d6fda30d0b92862ff1c65c6fcbcb50948e0faf8efa7f0a995e93c964aea')

build() {
  arch-meson "${pkgname}-${pkgver}" build
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 "${pkgname}-${pkgver}/com.github.gpuvis.Gpuvis.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "${pkgname}-${pkgver}/com.github.gpuvis.Gpuvis.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
}
