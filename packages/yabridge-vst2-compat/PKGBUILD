prepare() {
  cd "yabridge-${_commit}"
  for name in asio bitsery function2 ghc_filesystem tomlplusplus vst3; do
    mkdir -p "subprojects/${name}"
    bsdtar -xf "${srcdir}/${name}.tar.gz" --strip-components=1 -C "subprojects/${name}"
    if [[ -d "subprojects/packagefiles/${name}" ]]; then
      cp -a "subprojects/packagefiles/${name}/." "subprojects/${name}/"
    fi
  done
  for component in base pluginterfaces public-sdk; do
    target="subprojects/vst3/${component/-sdk/.sdk}"
    mkdir -p "$target"
    bsdtar -xf "${srcdir}/vst3-${component}.tar.gz" --strip-components=1 -C "$target"
  done
}

build() {
  cd "yabridge-${_commit}"
  meson setup build --buildtype=release --cross-file=cross-wine.conf \
    --wrap-mode=nodownload --unity=on --unity-size=1000 \
    -Dvst3=true -Dclap=false -Dbitbridge=false -Db_lto=false
  meson compile -C build -j 4
}

package() {
  cd "yabridge-${_commit}"
  install -Dm755 build/libyabridge-vst2.so "${pkgdir}/usr/lib/libyabridge-vst2.so"
  install -m755 build/libyabridge-chainloader-vst2.so "${pkgdir}/usr/lib/"
  install -Dm755 build/libyabridge-vst3.so "${pkgdir}/usr/lib/libyabridge-vst3.so"
  install -m755 build/libyabridge-chainloader-vst3.so "${pkgdir}/usr/lib/"
  install -Dm755 build/yabridge-host.exe "${pkgdir}/usr/bin/yabridge-host.exe"
  install -m755 build/yabridge-host.exe.so "${pkgdir}/usr/bin/"
  # Only use the stable release's management utility, never its Wine hosts.
  install -Dm755 "${srcdir}/yabridge/yabridgectl" "${pkgdir}/usr/bin/yabridgectl"
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
