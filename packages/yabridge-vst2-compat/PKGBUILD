pkgname=yabridge-vst2-compat
pkgver="5.1.1.r41.gba7022df"
pkgrel="2"
pkgdesc="Pinned yabridge Wine window-embedding compatibility branch, x64 VST2 and VST3"
arch=('x86_64')
url="https://github.com/robbert-vdh/yabridge"
license=('GPL-3.0-only')
depends=('wine' 'gcc-libs' 'glibc' 'libxcb')
makedepends=('meson' 'ninja' 'cmake' 'dbus')
provides=('yabridge' 'yabridgectl')
conflicts=('yabridge' 'yabridgectl' 'yabridge-bin' 'yabridge-git')
options=('!strip' '!debug' '!lto')
_commit=ba7022df0aee1e91cde62d7f0e940d3bc43a82b0
source=(
