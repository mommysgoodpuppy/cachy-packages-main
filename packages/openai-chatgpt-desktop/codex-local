#!/bin/sh
set -eu

: "${HOME:?HOME must be set}"
codex_local_home=${CODEX_LOCAL_HOME:-"${HOME}/.codex-local"}

if [ ! -f "${codex_local_home}/config.toml" ]; then
  printf 'codex-local: missing %s/config.toml\n' "${codex_local_home}" >&2
  printf 'Generate the local configuration before launching Codex Local.\n' >&2
  exit 1
fi

export CODEX_HOME="${codex_local_home}"
exec /usr/bin/codex "$@"
