pkgname=openai-chatgpt-desktop
pkgver="26.930.31730"
pkgrel="1"
pkgdesc="OpenAI ChatGPT desktop app repackaged from the official Linux binary"
arch=('x86_64')
url="https://chatgpt.com/download"
license=('custom')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'libcups'
  'libdrm'
  'libglvnd'
  'libnotify'
  'libusb'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'vulkan-driver'
  'xdg-utils'
  'xz'
)
provides=("chatgpt=${pkgver}")
conflicts=('chatgpt' 'openai-codex-desktop')
replaces=('openai-codex-desktop')
backup=('etc/apparmor.d/chatgpt')
options=('!strip' '!debug')

source=(
  "chatgpt_${pkgver}_amd64.deb::https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/chatgpt_${pkgver}_amd64.deb"
  'chatgpt-local'
  'codex-local'
  'chatgpt-local.desktop'
)
noextract=("chatgpt_${pkgver}_amd64.deb")
sha256sums=('e0174d8d0a5f4141145458c814f3c2d863dd67e942b868785a1f5dac9cba3e16'
            '969f5302af803d3a70a7b7da5761f1154b36e56503713587bf101ff36cc5f2bd'
            '9b94fb3e1a8a7e569a49191f32efa379bbf92612ebc901ff24a7d880ab082b46'
            '63a359ce2f3ccb2f040113592e1711360ab9a7fc884f8e865e3f8de86d69b630')

package() {
  bsdtar -xOf "${srcdir}/chatgpt_${pkgver}_amd64.deb" data.tar.xz |
    bsdtar --no-same-owner -xJf - -C "${pkgdir}"

  install -Dm755 "${srcdir}/chatgpt-local" "${pkgdir}/usr/bin/chatgpt-local"
  install -Dm755 "${srcdir}/codex-local" "${pkgdir}/usr/bin/codex-local"
  install -Dm644 "${srcdir}/chatgpt-local.desktop" \
    "${pkgdir}/usr/share/applications/chatgpt-local.desktop"

  ln -s chatgpt "${pkgdir}/usr/bin/chatgpt-desktop"
}
